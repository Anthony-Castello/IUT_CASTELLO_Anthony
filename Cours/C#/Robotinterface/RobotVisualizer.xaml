<UserControl x:Class="Robotinterface.RobotVisualizer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <Grid>
        <!-- Canvas pour la grille de fond -->
        <Canvas x:Name="GridCanvas" SizeChanged="Canvas_SizeChanged" />

        <!-- Canvas pour le robot et sa trace -->
        <Canvas x:Name="RobotCanvas">

            <!-- Trace du chemin parcouru (Ligne orange pointillée) -->
            <Polyline x:Name="RobotTrail" Stroke="#FF9900" StrokeThickness="2" StrokeDashArray="2,2"/>

            <!-- Forme de flèche représentant le robot -->
            <Path x:Name="RobotArrow" Fill="#00A2E8" Stretch="Fill" 
                  Width="30" Height="20" 
                  Data="M 0,20 L 30,10 L 0,0 L 8,10 Z" 
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <RotateTransform x:Name="RobotRotation" Angle="0"/>
                </Path.RenderTransform>
            </Path>
        </Canvas>
    </Grid>
</UserControl>
